{
  "name": "vitalis",
  "version": "0.1.0",
  "private": true,
  "description": "Vitalis — clinician-authored medical education video pipeline (see docs/PLAN.md)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "worker:dev": "pnpm --filter @vitalis/worker dev",
    "dashboard:dev": "pnpm --filter @vitalis/dashboard dev",
    "remotion:studio": "pnpm --filter @vitalis/remotion studio",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push"
  },
  "license": "MIT"
}
