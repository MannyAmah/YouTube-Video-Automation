{
  "name": "yva",
  "version": "2.0.0",
  "private": true,
  "description": "MedExplained \u2014 autonomous YouTube medication-education video platform (v2 rebuild)",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "dev:api": "pnpm --filter @yva/api dev",
    "dev:worker": "pnpm --filter @yva/worker dev",
    "dev:web": "pnpm --filter @yva/web dev",
    "db:migrate": "pnpm --filter @yva/db migrate:dev",
    "db:deploy": "pnpm --filter @yva/db migrate:deploy",
    "db:seed": "pnpm --filter @yva/db seed",
    "e2e:pipeline": "pnpm --filter @yva/worker e2e:pipeline"
  },
  "devDependencies": {
    "nx": "^21.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2"
  },
  "pnpm": {
    "overrides": {
      "minimatch@9": "^10.1.0",
      "uuid": ">=11.1.1"
    }
  }
}
