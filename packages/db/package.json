{
  "name": "@yva/db",
  "version": "2.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node dist/seed.js",
    "test": "echo 'db covered by apps/worker state-guard integration tests' && exit 0"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@yva/shared": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.1.0"
  }
}
