# ─────────────────────────────────────────────────────────────
# Vitalis environment — copy to .env and fill in. NEVER commit .env.
# (Iron Law #4: no secrets in code. Production uses Railway/Vercel
#  env vars or a secrets manager, not a committed file.)
# ─────────────────────────────────────────────────────────────

# --- Supabase (state / queue / storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # worker only — never ship to the browser
SUPABASE_ANON_KEY=                  # dashboard (RLS-scoped)

# --- Claude (script + fact-check reasoning) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_REASONING=claude-opus-4-8        # fact-check / script
CLAUDE_MODEL_FAST=claude-sonnet-4-6           # metadata / fast passes

# --- OpenAI (embeddings for topic/claim dedupe + RAG retrieval) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# --- ElevenLabs (founder voice: real -> cloned, see PLAN §0.5) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                # the founder voice clone id (once created)

# --- Image gen (NON-anatomical backgrounds only — PLAN §5) ---
REPLICATE_API_TOKEN=                # Flux / Ideogram via Replicate
IDEOGRAM_API_KEY=

# --- YouTube Data API v3 (publish) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3456/auth/callback
YOUTUBE_REFRESH_TOKEN=              # obtained via the OAuth flow, stored as a secret
YOUTUBE_CHANNEL_ID=

# --- Telegram (approval gate + voice-memo capture, PLAN §2.3/§7) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=           # scope to the founder's id ONLY

# --- Spend control (PLAN §10.4 — hard ceilings) ---
MONTHLY_BUDGET_USD=2000             # worker trips/alerts past this
MAX_CONCURRENT_RENDERS=2
