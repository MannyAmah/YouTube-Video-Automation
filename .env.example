# ---------------------------------------------------------------------------
# MedExplained v2 — environment contract
# Copy to .env for local development. On Railway, set these as service
# variables. Every variable is validated at boot by packages/shared/src/env.ts;
# the process refuses to start with an invalid configuration.
# NEVER commit real values.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3000
# Public base URL of the API service (used for OAuth callback URLs)
PUBLIC_URL=http://localhost:3000

# --- Database & queue ------------------------------------------------------
DATABASE_URL=postgresql://yva:yva_dev@127.0.0.1:5432/yva
REDIS_URL=redis://127.0.0.1:6379

# --- Security --------------------------------------------------------------
# 32-byte hex key for AES-256-GCM encryption of OAuth refresh tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
# Secret for signing admin session JWTs. Generate the same way.
SESSION_SECRET=REPLACE_WITH_RANDOM_STRING
# Initial admin login (email + password). Password is hashed on first boot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Media storage ---------------------------------------------------------
# Directory for rendered artifacts. On Railway, mount a volume here.
MEDIA_ROOT=./media-store

# --- Google / YouTube ------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth callback: ${PUBLIC_URL}/api/oauth/google/callback must be registered
# in the Google Cloud Console (see docs/GOOGLE_YOUTUBE_OAUTH.md).

# --- AI providers ----------------------------------------------------------
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Preferred narration voice (ElevenLabs voice ID). Empty = provider default.
ELEVENLABS_VOICE_ID=

# --- Pipeline policy -------------------------------------------------------
# autonomous: upload private -> automated QC -> auto-publish public
# supervised: pause at AWAITING_APPROVAL until a human approves
PUBLISH_MODE=autonomous
# Hard safety switch. true stops all queue processing and publishing.
EMERGENCY_PAUSE=false
# Maximum videos the system may publish per day (autonomous mode backstop).
MAX_PUBLISHES_PER_DAY=1

# --- Test mode -------------------------------------------------------------
# When true, AI/TTS/image/YouTube providers are replaced by deterministic
# fakes that are clearly labelled in artifacts and can NEVER reach a real
# YouTube channel. Research still uses the real FDA/NIH public APIs.
TEST_MODE=false
